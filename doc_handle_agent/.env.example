# FastAPI配置
APP_NAME=doc-handle-agent
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# LLM配置
LLM_PROVIDER=qwen
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-max-latest
LLM_REQUEST_TIMEOUT=300

# MCP配置
MCP_SERVER_URL=http://localhost:8000/mcp

# Workspace服务配置
WORKSPACE_SERVICE_URL=http://127.0.0.1:18867

# 路径配置
TEMPLATE_DIR=./templates
OUTPUT_DIR=./output
LOG_DIR=./log

# 日志配置
LOG_LEVEL=INFO

# 分批生成策略配置
# 每批最大模板 block 数量（静态/标题 block 不计入限制），默认 20，最小 1
BATCH_MAX_SIZE=20
# 函数明细批次最大并发数，仅作用于 get_all_methods 展开的函数章节，默认 10，最小 1
FUNCTION_BATCH_PARALLELISM=10

# 图片资源处理配置
# 图片下载最大并发数，请按知识库服务承载能力调整，默认 16
IMAGE_DOWNLOAD_PARALLELISM=16
# 图片上传最大并发数，请按 workspace 服务承载能力调整，默认 8
IMAGE_UPLOAD_PARALLELISM=8
# 是否同步查找并上传同名 drawio 源文件，默认 true
IMAGE_PROCESS_DRAWIO=true
