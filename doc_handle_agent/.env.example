# FastAPI配置
APP_NAME=doc-handle-agent
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# LLM配置
LLM_PROVIDER=qwen
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-max-latest
LLM_REQUEST_TIMEOUT=300

# MCP配置
MCP_SERVER_URL=http://localhost:8000/mcp

# Workspace服务配置
WORKSPACE_SERVICE_URL=http://127.0.0.1:18867

# 路径配置
TEMPLATE_DIR=./templates
OUTPUT_DIR=./output
LOG_DIR=./log

# 日志配置
LOG_LEVEL=INFO
